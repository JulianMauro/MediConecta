# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Variables de entorno: nunca subir secretos al repo (.env.example si va)
# El patron cubre las variantes que genera Vite (.env.local, .env.production),
# que con un ".env" pelado quedaban afuera y se podian commitear sin querer.
.env
.env.*
!.env.example

# Config local de Claude Code (herramienta, no parte de la app)
.claude/
