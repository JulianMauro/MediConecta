# Copiar como ".env" y completar. docker-compose lo lee solo.
# El .env real NO se sube al repo (esta en .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=mediconecta_db
POSTGRES_USER=mediconecta
POSTGRES_PASSWORD=cambiar-esta-password

# --- pgAdmin (http://localhost:5050) ---
PGADMIN_EMAIL=admin@mediconecta.com
PGADMIN_PASSWORD=cambiar-esta-password

# --- JWT ---
# HS512 necesita al menos 64 caracteres.
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria-de-al-menos-64-caracteres

# --- Usuario ADMIN inicial ---
ADMIN_EMAIL=admin@mediconecta.com
ADMIN_PASSWORD=cambiar-esta-password
